#!/usr/bin/env bash
set -e

echo "=========================================="
echo "      NovaOS Zero QEMU Headless Test      "
echo "=========================================="

QEMU=${QEMU:-qemu-system-x86_64}
OVMF=${OVMF:-/usr/share/ovmf/OVMF.fd}

cargo build --package uefi-loader --target x86_64-unknown-uefi
cargo build --package novaos-kernel --target x86_64-unknown-none

mkdir -p build/EFI/BOOT
cp target/x86_64-unknown-uefi/debug/uefi-loader.efi build/EFI/BOOT/BOOTX64.EFI
cp target/x86_64-unknown-none/debug/novaos-kernel build/novaos.elf

echo "Starting headless QEMU test..."
$QEMU -bios "$OVMF" -drive format=raw,file=fat:rw:build -serial stdio -display none -m 512M -device isa-debug-exit,iobase=0xf4,iosize=0x04 || true
echo "[SUCCESS] QEMU headless boot test executed."
