#!/usr/bin/env bash
set -e

echo "Building NovaOS Zero bootable disk..."
cargo build --package novaos-uefi-boot --target x86_64-unknown-uefi
cargo build --package novaos-kernel --target x86_64-unknown-none

mkdir -p build/EFI/BOOT
cp target/x86_64-unknown-uefi/debug/novaos-uefi-boot.efi build/EFI/BOOT/BOOTX64.EFI
cp target/x86_64-unknown-none/debug/novaos-kernel build/novaos.elf
cp novaos.cfg build/novaos.cfg || true
echo "Build complete."
