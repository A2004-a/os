{
  "name": "novaos",
  "version": "0.1.0",
  "description": "NovaOS — One Desktop. Three Worlds. One Experience.",
  "main": "dist/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json && npm run copy:wasm",
    "copy:wasm": "node -e \"const fs = require('fs'); fs.copyFileSync(require.resolve('sql.js/dist/sql-wasm.wasm'), 'dist/main/sql-wasm.wasm')\"",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron dist/main/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "package:win": "electron-builder --win",
    "package:dir": "electron-builder --dir"
  },
  "keywords": [
    "desktop-environment",
    "electron",
    "novaos",
    "hybrid-desktop"
  ],
  "author": "NovaOS Platform Engineering",
  "license": "Apache-2.0",
  "dependencies": {
    "@types/sql.js": "^1.4.11",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.16.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "io.novaos.desktop",
    "productName": "NovaOS",
    "copyright": "Copyright © 2026 NovaOS Platform Engineering",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dir",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "dir",
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
