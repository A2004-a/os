{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch NovaOS (Electron)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd",
      "args": [
        "dist/main/main.js"
      ],
      "outputCapture": "std"
    }
  ]
}
